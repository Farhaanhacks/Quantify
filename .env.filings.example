# Cloudflare account identifier shown on the R2 overview page.
R2_ACCOUNT_ID=

# Create an R2 API token with Object Read & Write access limited to the
# quantifi-filings-raw bucket. Cloudflare displays these two values once.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# This is the bucket NAME, not a URL and not an API key.
R2_BUCKET_NAME=quantifi-filings-raw

# Optional folder at the top of the bucket.
R2_FILINGS_PREFIX=filings

# Generate an independent random secret for POST /api/filings/ingest.
# Example command: openssl rand -base64 48
FILINGS_INGEST_SECRET=

# Existing Quantifi KV database. Parsed facts still use this in this package.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# These are data-source credentials, not R2 credentials. Leave unset until a
# licensed NSE/BSE feed is available.
NSE_FEED_STAGING_URL=
NSE_FEED_TOKEN=
BSE_API_URL=
BSE_API_KEY=
