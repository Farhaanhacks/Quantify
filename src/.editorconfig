# Keeps every editor writing files the way Node, TypeScript and Next expect.
# A UTF-8 BOM or a UTF-16 save makes parsers fail on line 1, column 1 — which is
# what "TS1005: '{' expected" at the top of a config file means.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
