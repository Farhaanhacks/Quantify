# Normalise line endings on the way in, and check every text file out as LF —
# so a Windows editor can't commit CRLF or drift the working tree.
* text=auto eol=lf

# Binary: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
